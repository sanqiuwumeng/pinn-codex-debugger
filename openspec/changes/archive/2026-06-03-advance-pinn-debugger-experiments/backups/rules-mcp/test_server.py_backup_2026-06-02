"""Low-level MCP JSON-RPC handler tests."""

from __future__ import annotations

import json
import unittest

from rules_mcp.server import PROTOCOL_VERSION

from .support import create_server


class StdioMcpServerTests(unittest.TestCase):
    def setUp(self) -> None:
        self.server = create_server()

    def test_initialize_declares_tools_capability(self) -> None:
        response = self.server.handle_message(
            json.dumps(
                {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                        "protocolVersion": PROTOCOL_VERSION,
                        "capabilities": {},
                        "clientInfo": {"name": "test-client", "version": "0.1.0"},
                    },
                }
            )
        )
        self.assertEqual(response["result"]["protocolVersion"], PROTOCOL_VERSION)
        self.assertEqual(response["result"]["capabilities"], {"tools": {}})

    def test_tools_list_exposes_explicit_schemas(self) -> None:
        response = self.server.handle_message(
            json.dumps(
                {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}
            )
        )
        tools = response["result"]["tools"]
        self.assertEqual(
            [tool["name"] for tool in tools],
            ["diagnose_pinn_symptom", "search_pinn_handbook"],
        )
        self.assertTrue(all("inputSchema" in tool for tool in tools))
        self.assertTrue(all("outputSchema" in tool for tool in tools))

    def test_tools_call_returns_structured_and_text_content(self) -> None:
        response = self.server.handle_message(
            json.dumps(
                {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                        "name": "diagnose_pinn_symptom",
                        "arguments": {
                            "symptom": "四阶导数训练很慢，显存高，loss 抖动。",
                        },
                    },
                },
                ensure_ascii=False,
            )
        )
        result = response["result"]
        self.assertFalse(result["isError"])
        self.assertEqual(
            result["structuredContent"]["family"],
            "high-order autodiff cost",
        )
        self.assertEqual(result["content"][0]["type"], "text")

    def test_invalid_tool_arguments_return_tool_error(self) -> None:
        response = self.server.handle_message(
            json.dumps(
                {
                    "jsonrpc": "2.0",
                    "id": 4,
                    "method": "tools/call",
                    "params": {
                        "name": "diagnose_pinn_symptom",
                        "arguments": {"symptom": ""},
                    },
                }
            )
        )
        self.assertTrue(response["result"]["isError"])


if __name__ == "__main__":
    unittest.main()
